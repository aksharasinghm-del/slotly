# Public URL of the site (no trailing slash). Must match the redirect URI in Google Cloud.
BASE_URL=http://localhost:3000
PORT=3000
# Long random string used to sign session cookies: `openssl rand -hex 32`
SESSION_SECRET=change-me
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional
APP_NAME=Slotly
DATABASE_PATH=./data/slotly.db
# Only these Google accounts may sign in as hosts (comma-separated). Leave empty to allow anyone.
ALLOWED_EMAILS=
