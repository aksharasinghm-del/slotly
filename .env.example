# Free hosted database from https://turso.tech (leave empty to use a local file in ./data)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# From Google Cloud Console → Google Auth Platform → Clients (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only these Google accounts may sign in as hosts (comma-separated). Leave empty to allow anyone.
ALLOWED_EMAILS=
# Optional. Detected automatically on Vercel and Render.
BASE_URL=
SESSION_SECRET=
APP_NAME=Slotly
